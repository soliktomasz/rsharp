<Project Sdk="Microsoft.NET.Sdk">
  <!-- Passenger.Xaml in a process of its own, speaking JSON lines as Passenger.Host does: RSharp's editor asks it what a
       XAML file completes, what it warns of and where a name leads (src/rsharp-lsp/src/xaml.rs is the other side). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RSharp.XamlHost</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- The previewer's own entry, a project of its own (build.rs publishes it into preview/). -->
    <Compile Remove="preview/**" />
    <!-- What RSharp and WPF's previewer say to each other, compiled into both, as Passenger's app compiles it. -->
    <Compile Include="../../../vendor/passenger/src/Passenger.WpfPreview/Protocol.cs" Link="WpfPreviewProtocol.cs" />
    <ProjectReference Include="../../../vendor/passenger/src/Passenger.Xaml/Passenger.Xaml.csproj" />
    <!-- Avalonia's previewer protocol (MIT), which the preview speaks to the project's Avalonia.Designer.HostApp. -->
    <PackageReference Include="Avalonia.Remote.Protocol" />
    <!-- ILSpy's decompiler (MIT), for Go to Declaration into a library's type, as Passenger's LibrarySources has it. -->
    <PackageReference Include="ICSharpCode.Decompiler" />
  </ItemGroup>
</Project>
