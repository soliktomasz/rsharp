<Project>
  <!-- Passenger's own settings, so Passenger.Xaml and this host build alike; its output under target/, never here. -->
  <Import Project="../../../vendor/passenger/Directory.Build.props" />
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../../../target/profiler-host</ArtifactsPath>
  </PropertyGroup>
</Project>
